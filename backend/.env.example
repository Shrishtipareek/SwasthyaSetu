# Copy to backend/.env and fill in real values. Never commit backend/.env.
PORT=5000
NODE_ENV=development
# 127.0.0.1 avoids IPv6 "localhost" resolution problems with a local mongod
MONGO_URI=mongodb://127.0.0.1:27017/SwasthyaSetu
# Replace with a long random string (production refuses anything under 32 characters)
JWT_SECRET=change_me
JWT_EXPIRE=30d
# Comma-separated allowed frontend origins, enforced when NODE_ENV=production
CLIENT_URL=http://localhost:5173
# Optional: without a key CareAI uses its built-in rule engine
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
